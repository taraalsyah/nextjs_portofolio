datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL_MYSQL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                Int                 @id @default(autoincrement())
  name              String
  username          String?             @unique
  email             String              @unique
  password          String
  role              String              @default("user") // Fallback
  roleId            Int?                @map("role_id")
  roleRel           Role?               @relation("UserRole", fields: [roleId], references: [id], onDelete: SetNull)
  status            String              @default("PENDING") // PENDING, ACTIVE, BLOCKED
  phone             String?
  image             String?
  otpAttemptCount   Int                 @default(0) @map("otp_attempt_count")
  otpSoftBlockUntil DateTime?           @map("otp_soft_block_until")
  otpSoftBlockCount Int                 @default(0) @map("otp_soft_block_count")
  emailVerifiedAt   DateTime?           @map("email_verified_at")
  lastLoginAt       DateTime?           @map("last_login_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  verifications     EmailVerification[]
  passwordResets    PasswordResetToken[]
  activityLogs      ActivityLog[]

  // Task Management & Project Relations
  assignedTasks     Task[]              @relation("TaskAssignee")
  createdTasks      Task[]              @relation("TaskCreator")
  taskComments      TaskComment[]
  taskAttachments   TaskAttachment[]
  taskHistories     TaskHistory[]
  ownedProjects     Project[]           @relation("ProjectOwner")
  projectMemberships ProjectMember[]

  @@map("users")
}

model EmailVerification {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  code       String
  expiredAt  DateTime  @map("expired_at")
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verifications")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  usedAt    DateTime? @map("used_at")
  ipAddress String?   @map("ip_address")
  userAgent String?   @map("user_agent")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model ActivityLog {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  projectId   Int?     @map("project_id")
  action      String   // CREATE, UPDATE, DELETE, LOGIN, LOGOUT, PROJECT_*
  description String   @db.Text
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@map("activity_logs")
}

model Role {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  description     String?          @db.Text
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  users           User[]           @relation("UserRole")
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id              Int              @id @default(autoincrement())
  module          String
  action          String
  description     String?          @db.Text
  createdAt       DateTime         @default(now()) @map("created_at")
  rolePermissions RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int        @map("role_id")
  permissionId Int        @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model TaskCategory {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  tasks       Task[]

  @@map("task_categories")
}

model Project {
  id          Int             @id @default(autoincrement())
  projectName String          @map("project_name")
  description String?         @db.Text
  ownerUserId Int             @map("owner_user_id")
  visibility  String          @default("PRIVATE") // PRIVATE, TEAM
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  owner       User            @relation("ProjectOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  members     ProjectMember[]
  tasks       Task[]
  activityLogs ActivityLog[]
  rolePermissions ProjectRolePermission[]
  workflowPermissions ProjectWorkflowPermission[]

  @@index([ownerUserId])
  @@map("projects")
}

model ProjectMember {
  id        Int      @id @default(autoincrement())
  projectId Int      @map("project_id")
  userId    Int      @map("user_id")
  role      String   @default("MEMBER") // OWNER, ADMIN, MEMBER, VIEWER
  joinedAt  DateTime @default(now()) @map("joined_at")

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

model Task {
  id          Int              @id @default(autoincrement())
  taskNumber  String           @unique @map("task_number") // TSK-000001
  projectId   Int?             @map("project_id")
  title       String
  description String           @db.Text
  status      String           @default("BACKLOG") // BACKLOG, OPEN, IN_PROGRESS, DONE
  priority    String           @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  assigneeId  Int?             @map("assignee_id")
  createdById Int              @map("created_by_id")
  categoryId  Int?             @map("category_id")
  tags        String?          @db.Text
  startDate   DateTime?        @map("start_date")
  dueDate     DateTime?        @map("due_date")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  deletedAt   DateTime?        @map("deleted_at") // Soft Delete

  project     Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    User?            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy   User             @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)
  category    TaskCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  checklists  TaskChecklist[]
  comments    TaskComment[]
  attachments TaskAttachment[]
  histories   TaskHistory[]

  // Indexes & Composite Indexes for Production Performance (100k+ tasks)
  @@index([projectId])
  @@index([status])
  @@index([priority])
  @@index([assigneeId])
  @@index([createdById])
  @@index([categoryId])
  @@index([dueDate])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([deletedAt])

  @@index([projectId, status])
  @@index([projectId, assigneeId])
  @@index([status, priority])
  @@index([assigneeId, status])
  @@index([createdById, createdAt])
  @@index([categoryId, status])
  @@index([deletedAt, assigneeId, status])

  @@map("tasks")
}

model TaskChecklist {
  id          Int      @id @default(autoincrement())
  taskId      Int      @map("task_id")
  title       String
  isCompleted Boolean  @default(false) @map("is_completed")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_checklists")
}

model TaskComment {
  id        Int      @id @default(autoincrement())
  taskId    Int      @map("task_id")
  userId    Int      @map("user_id")
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
  @@map("task_comments")
}

model TaskAttachment {
  id           Int      @id @default(autoincrement())
  taskId       Int      @map("task_id")
  uploadedById Int      @map("uploaded_by_id")
  fileName     String   @map("file_name")
  fileUrl      String   @db.LongText @map("file_url")
  fileSize     Int      @map("file_size")
  fileType     String   @map("file_type")
  createdAt    DateTime @default(now()) @map("created_at")

  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([uploadedById])
  @@map("task_attachments")
}

model TaskHistory {
  id            Int      @id @default(autoincrement())
  taskId        Int      @map("task_id")
  userId        Int      @map("user_id")
  action        String
  fieldName     String?  @map("field_name")
  previousValue String?  @db.Text @map("previous_value")
  newValue      String?  @db.Text @map("new_value")
  createdAt     DateTime @default(now()) @map("created_at")

  task          Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
  @@map("task_histories")
}

model ProjectRolePermission {
  id            Int      @id @default(autoincrement())
  projectId     Int      @map("project_id")
  role          String   // OWNER, ADMIN, MEMBER, VIEWER
  permissionKey String   @map("permission_key")
  isAllowed     Boolean  @default(true) @map("is_allowed")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, role, permissionKey])
  @@index([projectId, role])
  @@map("project_role_permissions")
}

model ProjectWorkflowPermission {
  id         Int      @id @default(autoincrement())
  projectId  Int      @map("project_id")
  role       String   // OWNER, ADMIN, MEMBER, VIEWER
  fromStatus String   @map("from_status")
  toStatus   String   @map("to_status")
  isAllowed  Boolean  @default(true) @map("is_allowed")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, role, fromStatus, toStatus])
  @@index([projectId, role])
  @@map("project_workflow_permissions")
}

