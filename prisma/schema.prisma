generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL_MYSQL")
}

model User {
  id                  Int                  @id @default(autoincrement())
  name                String
  email               String               @unique
  password            String
  role                String               @default("user")
  status              String               @default("PENDING")
  emailVerifiedAt     DateTime?            @map("email_verified_at")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  image               String?
  lastLoginAt         DateTime?            @map("last_login_at")
  phone               String?
  username            String?              @unique
  roleId              Int?                 @map("role_id")
  otpAttemptCount     Int                  @default(0) @map("otp_attempt_count")
  otpSoftBlockCount   Int                  @default(0) @map("otp_soft_block_count")
  otpSoftBlockUntil   DateTime?            @map("otp_soft_block_until")
  apiToken            String?              @unique @map("api_token")
  activityLogs        ActivityLog[]
  verifications       EmailVerification[]
  passwordResets      PasswordResetToken[]
  projectMemberships  ProjectMember[]
  ownedProjects       Project[]            @relation("ProjectOwner")
  taskAttachments     TaskAttachment[]
  taskComments        TaskComment[]
  taskHistories       TaskHistory[]
  assignedTasks       Task[]               @relation("TaskAssignee")
  closeRequestedTasks Task[]               @relation("CloseRequester")
  closeReviewedTasks  Task[]               @relation("CloseReviewer")
  createdTasks        Task[]               @relation("TaskCreator")
  doneRequestedTasks  Task[]               @relation("DoneRequester")
  doneReviewedTasks   Task[]               @relation("DoneReviewer")
  roleRel             Role?                @relation("UserRole", fields: [roleId], references: [id])

  @@index([roleId], map: "users_role_id_fkey")
  @@map("users")
}

model EmailVerification {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  code       String
  expiredAt  DateTime  @map("expired_at")
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "email_verifications_user_id_fkey")
  @@map("email_verifications")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  usedAt    DateTime? @map("used_at")
  ipAddress String?   @map("ip_address")
  userAgent String?   @map("user_agent")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "password_reset_tokens_user_id_fkey")
  @@map("password_reset_tokens")
}

model ActivityLog {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  action      String
  description String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  projectId   Int?     @map("project_id")
  project     Project? @relation(fields: [projectId], references: [id])
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId], map: "activity_logs_user_id_fkey")
  @@map("activity_logs")
}

model Role {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  description     String?          @db.Text
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  rolePermissions RolePermission[]
  users           User[]           @relation("UserRole")

  @@map("roles")
}

model Permission {
  id              Int              @id @default(autoincrement())
  module          String
  action          String
  description     String?          @db.Text
  createdAt       DateTime         @default(now()) @map("created_at")
  rolePermissions RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int        @map("role_id")
  permissionId Int        @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId], map: "role_permissions_permission_id_fkey")
  @@map("role_permissions")
}

model TaskCategory {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  tasks       Task[]

  @@map("task_categories")
}

model Project {
  id                  Int                         @id @default(autoincrement())
  projectName         String                      @map("project_name")
  description         String?                     @db.Text
  ownerUserId         Int                         @map("owner_user_id")
  visibility          String                      @default("PRIVATE")
  createdAt           DateTime                    @default(now()) @map("created_at")
  updatedAt           DateTime                    @updatedAt @map("updated_at")
  inviteCode          String?                     @unique @map("invite_code")
  activityLogs        ActivityLog[]
  members             ProjectMember[]
  rolePermissions     ProjectRolePermission[]
  workflowPermissions ProjectWorkflowPermission[]
  owner               User                        @relation("ProjectOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  tasks               Task[]

  @@index([ownerUserId])
  @@map("projects")
}

model ProjectMember {
  id        Int      @id @default(autoincrement())
  projectId Int      @map("project_id")
  userId    Int      @map("user_id")
  role      String   @default("MEMBER")
  joinedAt  DateTime @default(now()) @map("joined_at")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

model Task {
  id                 Int              @id @default(autoincrement())
  taskNumber         String           @unique @map("task_number")
  title              String
  description        String           @db.Text
  status             String           @default("BACKLOG")
  priority           String           @default("MEDIUM")
  assigneeId         Int?             @map("assignee_id")
  createdById        Int              @map("created_by_id")
  categoryId         Int?             @map("category_id")
  tags               String?          @db.Text
  startDate          DateTime?        @map("start_date")
  dueDate            DateTime?        @map("due_date")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  deletedAt          DateTime?        @map("deleted_at")
  projectId          Int?             @map("project_id")
  closeRejectReason  String?          @map("close_reject_reason") @db.Text
  closeRequestReason String?          @map("close_request_reason") @db.Text
  closeRequestStatus String           @default("NONE") @map("close_request_status")
  closeRequestedAt   DateTime?        @map("close_requested_at")
  closeRequestedById Int?             @map("close_requested_by_id")
  closeReviewedAt    DateTime?        @map("close_reviewed_at")
  closeReviewedById  Int?             @map("close_reviewed_by_id")
  doneRequestStatus  String           @default("NONE") @map("done_request_status")
  doneRequestedById  Int?             @map("done_requested_by_id")
  doneRequestedAt    DateTime?        @map("done_requested_at")
  doneRequestNote    String?          @map("done_request_note") @db.Text
  doneReviewedById   Int?             @map("done_reviewed_by_id")
  doneReviewedAt     DateTime?        @map("done_reviewed_at")
  doneRejectReason   String?          @map("done_reject_reason") @db.Text
  isLocked           Boolean          @default(false) @map("is_locked")
  attachments        TaskAttachment[]
  checklists         TaskChecklist[]
  comments           TaskComment[]
  histories          TaskHistory[]
  assignee           User?            @relation("TaskAssignee", fields: [assigneeId], references: [id])
  category           TaskCategory?    @relation(fields: [categoryId], references: [id])
  closeRequestedBy   User?            @relation("CloseRequester", fields: [closeRequestedById], references: [id])
  closeReviewedBy    User?            @relation("CloseReviewer", fields: [closeReviewedById], references: [id])
  createdBy          User             @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)
  doneRequestedBy    User?            @relation("DoneRequester", fields: [doneRequestedById], references: [id])
  doneReviewedBy     User?            @relation("DoneReviewer", fields: [doneReviewedById], references: [id])
  project            Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@index([priority])
  @@index([assigneeId])
  @@index([createdById])
  @@index([categoryId])
  @@index([dueDate])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([deletedAt])
  @@index([projectId, status])
  @@index([projectId, assigneeId])
  @@index([status, priority])
  @@index([assigneeId, status])
  @@index([createdById, createdAt])
  @@index([categoryId, status])
  @@index([deletedAt, assigneeId, status])
  @@index([closeRequestedById], map: "tasks_close_requested_by_id_fkey")
  @@index([closeReviewedById], map: "tasks_close_reviewed_by_id_fkey")
  @@map("tasks")
}

model TaskChecklist {
  id          Int      @id @default(autoincrement())
  taskId      Int      @map("task_id")
  title       String
  isCompleted Boolean  @default(false) @map("is_completed")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_checklists")
}

model TaskComment {
  id        Int      @id @default(autoincrement())
  taskId    Int      @map("task_id")
  userId    Int      @map("user_id")
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
  @@map("task_comments")
}

model TaskAttachment {
  id           Int      @id @default(autoincrement())
  taskId       Int      @map("task_id")
  uploadedById Int      @map("uploaded_by_id")
  fileName     String   @map("file_name")
  fileUrl      String   @map("file_url") @db.LongText
  fileSize     Int      @map("file_size")
  fileType     String   @map("file_type")
  createdAt    DateTime @default(now()) @map("created_at")
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([uploadedById])
  @@map("task_attachments")
}

model TaskHistory {
  id            Int      @id @default(autoincrement())
  taskId        Int      @map("task_id")
  userId        Int      @map("user_id")
  action        String
  fieldName     String?  @map("field_name")
  previousValue String?  @map("previous_value") @db.Text
  newValue      String?  @map("new_value") @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  task          Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
  @@map("task_histories")
}

model ProjectRolePermission {
  id            Int      @id @default(autoincrement())
  projectId     Int      @map("project_id")
  role          String
  permissionKey String   @map("permission_key")
  isAllowed     Boolean  @default(true) @map("is_allowed")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, role, permissionKey])
  @@index([projectId, role])
  @@map("project_role_permissions")
}

model ProjectWorkflowPermission {
  id         Int      @id @default(autoincrement())
  projectId  Int      @map("project_id")
  role       String
  fromStatus String   @map("from_status")
  toStatus   String   @map("to_status")
  isAllowed  Boolean  @default(true) @map("is_allowed")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, role, fromStatus, toStatus])
  @@index([projectId, role])
  @@map("project_workflow_permissions")
}
